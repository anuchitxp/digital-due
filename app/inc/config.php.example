        // (checked in the docs/07 §5 go-live checklist).
        'dev_impersonate' => true,
        'session_idle_seconds' => 900,  // NFR-6
        'units' => ['CARDIO' => 'อายุรกรรมหัวใจ', 'ENDO' => 'อายุรกรรมต่อมไร้ท่อ'],
