        'password' => getenv('DUE_DB_PASS') ?: 'Due#App-2024!',
        'timeout'  => 10,               // seconds (FR-1.3 graceful fallback)
    ],
    'app' => [
        // DEV ONLY (docs/09 §5): allows ?devu=HOSP\due_doc1 login simulation on Linux,
